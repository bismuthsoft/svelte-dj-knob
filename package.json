{
	"name": "svelte-dj-knob",
	"version": "0.2.1",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./MinimalKnob.svelte": {
			"types": "./dist/MinimalKnob.svelte.d.ts",
			"svelte": "./dist/MinimalKnob.svelte"
		},
		"./ElegantKnob.svelte": {
			"types": "./dist/ElegantKnob.svelte.d.ts",
			"svelte": "./dist/ElegantKnob.svelte"
		},
		"./Input.svelte": {
			"types": "./dist/Input.svelte.d.ts",
			"svelte": "./dist/Input.svelte"
		},
		"./Options.svelte": {
			"types": "./dist/Options.svelte.d.ts",
			"svelte": "./dist/Options.svelte"
		},
		"./knobdrag": {
			"types": "./dist/knobdrag.d.ts",
			"default": "./dist/knobdrag.js"
		},
		"./knobdrag.js": {
			"types": "./dist/knobdrag.d.ts",
			"default": "./dist/knobdrag.js"
		},
		"./options": {
			"types": "./dist/options.d.ts",
			"default": "./dist/options.js"
		},
		"./options.js": {
			"types": "./dist/options.d.ts",
			"default": "./dist/options.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"package": "svelte-kit sync && svelte-package",
		"prepack": "npm run package",
		"publish": "git push && npm run package && npm publish",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-auto": "^9.0.0",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/package": "^3.0.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"colorjs.io": "^0.7.1",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.13.1",
			"onFail": "download"
		}
	}
}
